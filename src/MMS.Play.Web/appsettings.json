{
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Serilog": {
    "Using": [
      "Serilog.Enrichers.Environment",
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.Grafana.Loki",
      "Serilog.Sinks.MSSqlServer"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning",
        "System.Net.Http.HttpClient.telegram": "Warning",
        "Hangfire": "Information"
      }
    },
    "WriteTo": {
      "Console": {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      "File": {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      "Database": {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "DefaultConnection",
          "restrictedToMinimumLevel": "Information",
          "sinkOptionsSection": {
            "tableName": "Logs",
            "schemaName": "dbo",
            "autoCreateSqlTable": false,
            "batchPostingLimit": 50,
            "period": "0.00:00:05"
          },
          "columnOptionsSection": {
            "removeStandardColumns": [ "Properties" ],
            "addStandardColumns": [ "LogEvent" ],
            "timeStamp": { "columnName": "TimeStamp", "convertToUtc": true },
            "additionalColumns": [
              { "ColumnName": "SourceContext", "DataType": "nvarchar", "DataLength": 256, "AllowNull": true }
            ]
          }
        }
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithEnvironmentName" ],
    "Properties": {
      "Application": "MMS.Play.API"
    }
  },
  "Swagger": {
    "Enabled": false,
    "Title": "MMS.Play API",
    "Description": "MMS.Play backend API",
    "RoutePrefix": "swagger"
  },
  "Metrics": {
    "Enabled": false,
    "ServiceName": "mms-play-api",
    "OtlpEndpoint": "http://localhost:9090/api/v1/otlp/v1/metrics",
    "ExportIntervalSeconds": 15
  },
  "Hangfire": {
    "SchemaName": "hangfire",
    "WorkerCount": 5,
    "Queues": [ "default" ],
    "Dashboard": {
      "Enabled": true,
      "Path": "/hangfire",
      "Title": "MMS.Play Jobs",
      "ReadOnly": false
    }
  },
  "DocumentStorage": {
    "Provider": "Local",
    "Local": {
      "RootPath": "../../@data"
    }
  },
  "Scores": {
    "Folder": "scores",
    "MaxFileSizeBytes": 10485760
  },
  "Identity": {
    "SeedUsers": []
  },
  "LogCleanup": {
    "RetentionDays": 7,
    "BatchSize": 5000
  },
  // where the website is reachable from the internet, for the links the bot sends (calendar, practice, trial lesson)
  "PublicSite": {
    "BaseUrl": ""
  },
  // trial lessons for newcomers (bot and the public page /trial); "Enabled" is the default until the notification settings are saved
  "TrialBooking": {
    "Enabled": true,
    "DaysAhead": 14,
    "MinNoticeHours": 24,
    "MaxWebsiteRequestsPerHour": 10
  },
  "Telegram": {
    "Enabled": false,
    "BotUsername": "",
    "BotToken": ""
  },
  "Lessons": {
    "TimeZoneId": "Europe/Kyiv",
    "DefaultLessonPrice": 500,
    "SeedDemoData": false
  },
  "LessonReminders": {
    "MessageTemplate": "Привіт, {FirstName}! 👋\nНе забудь, що <b>{LessonDay} о {LessonTime}</b> у тебе урок 🎸\nКабінет {Room}, викладач — {Teacher}. До зустрічі!",
    "ParentMessageTemplate": "Добрий день, {FirstName}! 👋\nНагадуємо: <b>{LessonDay} о {LessonTime}</b> у вашої дитини ({ChildName}) урок 🎸\nКабінет {Room}, викладач — {Teacher}. Будь ласка, нагадайте про нього 🙂",
    "Enabled": true,
    "DaysBefore": 2,
    "Times": [ "09:00", "13:00" ],
    "Culture": "uk-UA",
    "MissedSlotGraceMinutes": 120,
    "MessagesPerSecond": 25
  },
  "PaymentReminders": {
    "StudentMessageTemplate": "Привіт, {FirstName}! 👋\nНагадуємо, що не оплачено уроків: <b>{UnpaidCount}</b> на суму <b>{UnpaidAmount}</b>:\n{UnpaidLessons}\nБудь ласка, оплати їх найближчим часом. Дякуємо! 🎸",
    "ParentMessageTemplate": "Добрий день, {FirstName}! 👋\nНагадуємо, що за уроки вашої дитини ({ChildName}) не оплачено: <b>{UnpaidCount}</b> на суму <b>{UnpaidAmount}</b>:\n{UnpaidLessons}\nБудь ласка, оплатіть їх найближчим часом. Дякуємо! 🙂",
    "Enabled": true,
    "Time": "10:00",
    "EveryDays": 3,
    "MaxListedLessons": 10
  },
  "HomeworkReminders": {
    "AssignedMessageTemplate": "Привіт, {FirstName}! 🎸\nНове домашнє завдання:\n\n{Homework}\n{DueDate}\n\n{PracticeLink}\nКоли позаймаєшся, натисни «✅ Позаймався» — так викладач бачить твій прогрес.",
    "ReminderMessageTemplate": "Привіт, {FirstName}! 🎸\nЧас позайматися 15–20 хвилин:\n\n{Homework}\n\nДнів поспіль: <b>{Streak}</b> 🔥\n{PracticeLink}\nПісля заняття натисни «✅ Позаймався».",
    "Enabled": true,
    "Time": "18:00",
    "MaxListed": 5
  },
  // the daily summary for admins in the bot; defaults until an admin saves the notification settings
  "AdminDigest": {
    "Enabled": true,
    "Time": "08:00"
  },
  "Jobs": {
    "CleanupLogs": {
      "Schedule": "0 3 * * *"
    },
    "LessonReminders": {
      "Enabled": false,
      "Schedule": "* * * * *"
    }
  },
  "AllowedHosts": "*"
}
